{
  "name": "FutatsumeWatch",
  "description": "niconico HTML5 Player",
  "version": "0.0.15",
  "private": true,
  "author": "roflsunriz",
  "bugs": {
    "url": "https://github.com/roflsunriz/FutatsumeWatch/issues"
  },
  "dependencies": {
    "comment-overlay": "4.1.6",
    "hls.js": "1.7.3",
    "jquery": "^3.3.1",
    "lit": "^2.0.2",
    "lodash": "^4.17.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/jquery": "3",
    "@types/jsdom": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "typescript": "5",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0",
    "vite-plugin-monkey": "8.1.1"
  },
  "homepage": "https://github.com/roflsunriz/FutatsumeWatch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/roflsunriz/FutatsumeWatch.git"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "type-check": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "build:dev": "bun scripts/build.ts",
    "test": "bun test --preload ./test/setup.ts",
    "test:browser": "bun scripts/test-browser.ts",
    "test:browser:stop": "bun scripts/dev-browser.ts stop --test",
    "dev:server": "bun --bun vite",
    "dev:setup": "bun scripts/dev-setup.ts",
    "dev:browse": "bun scripts/dev-browser.ts start",
    "dev:stop": "bun scripts/dev-browser.ts stop",
    "dev:install": "bun scripts/dev-install.ts",
    "dev:check": "bun scripts/dev-check-installation.ts",
    "dev:verify": "bun scripts/test-browser.ts player",
    "dev:verify:ui": "bun scripts/test-browser.ts ui",
    "dev:verify:settings": "bun scripts/test-browser.ts settings",
    "dev:verify:migration": "bun scripts/test-browser.ts migration",
    "dev": "bun scripts/dev-setup.ts --if-missing && bun run build && bun scripts/dev-browser.ts start && bun scripts/dev-install.ts",
    "dev:verify:entry": "bun scripts/test-browser.ts entry",
    "dev:verify:addons": "bun scripts/test-browser.ts addons"
  },
  "type": "module"
}
