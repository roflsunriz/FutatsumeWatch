{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": false,
    // toSorted は製品出荷済みのため lib のみ ES2023（実行時変更なし）。
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // comment-overlay 4.1.6 の公開 d.ts に残る内部 alias を実際の型定義へ解決する。
    "paths": { "@/*": ["./node_modules/comment-overlay/dist/types/*"] },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "allowJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowUmdGlobalAccess": false,
    "types": ["bun"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "packages/**/*.ts", "vite.config.mts"]
}
